#include <stdio.h>

int main() {
    int A[2][4], B[4][5];
    int C[2][5] = {0}; 
    int i, j, k;

    printf("請輸入矩陣 A 的數值 (2x4，共 8 個整數)：\n");
    for (i = 0; i < 2; i++) {
        for (j = 0; j < 4; j++) {
            scanf("%d", &A[i][j]);
        }
    }

    printf("\n請輸入矩陣 B 的數值 (4x5，共 20 個整數)：\n");
    for (i = 0; i < 4; i++) {
        for (j = 0; j < 5; j++) {
            scanf("%d", &B[i][j]);
        }
    }

    for (i = 0; i < 2; i++) {
        for (j = 0; j < 5; j++) {
            for (k = 0; k < 4; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    printf("\n矩陣相乘結果C(2x5)\n");
    for (i = 0; i < 2; i++) {
        printf("row%d ->. ", i + 1); 
        
        for (j = 0; j < 5; j++) {
            printf("%d", C[i][j]); 

            if (j < 4) {
                printf(", ");
            }
        }
        printf("\n");
    }

    return 0;
}
